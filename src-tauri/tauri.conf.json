{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "花瓣工具箱",
  "version": "0.1.0",
  "identifier": "com.petaltoolbox.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "orb-window",
        "title": "花瓣工具箱",
        "url": "index.html?window=orb",
        "width": 88,
        "height": 88,
        "minWidth": 88,
        "minHeight": 88,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "visible": true
      },
      {
        "label": "panel-window",
        "title": "花瓣工具箱",
        "url": "index.html?window=panel",
        "width": 560,
        "height": 540,
        "minWidth": 420,
        "minHeight": 420,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "maximizable": false,
        "minimizable": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "capabilities": ["orb", "panel"],
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "低打扰的桌面悬浮办公与开发辅助工具箱"
  }
}
